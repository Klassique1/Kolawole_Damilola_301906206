# Copy this file to .env and fill in your local values.
# NEVER commit .env to Git.

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=portfolio_db
PGUSER=portfolio_app
PGPASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
PGADMIN_USER=postgres
PGADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=portfolio_nosql

# Portfolio Metadata
CASE_STUDY_FILE=case_study.json
EVIDENCE_DIR_NAME=evidence
